# ---- Core ----
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the dashboard API
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://inspectflow@127.0.0.1:5433/inspectflow

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECRET=change-me-cookie-secret

# ---- Object storage (S3-compatible: MinIO / Cloudflare R2 / Supabase) ----
# STORAGE_DRIVER=local stores files under ./uploads (development only)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=inspectflow-screenshots
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ---- Widget ----
WIDGET_MAX_PAYLOAD_KB=2048
WIDGET_RATE_LIMIT_PER_MIN=20


# ---- Retention ----
# Delete screenshots of VERIFIED tickets after this many days (0 = keep forever).
# Run: pnpm --filter @inspectflow/api retention
SCREENSHOT_RETENTION_DAYS=0
