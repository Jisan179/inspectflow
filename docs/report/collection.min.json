{"info":{"name":"InspectFlow API (report)","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"variable":[{"key":"base","value":"http://localhost:5001"}],"item":[{"name":"1 Auth","item":[{"name":"01 Register (201)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/auth/register","body":{"mode":"raw","raw":"{\n  \"name\": \"Report Student\",\n  \"email\": \"student{{$timestamp}}@example.test\",\n  \"password\": \"Password123\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"201 Created, no password hash returned\", () => { pm.response.to.have.status(201); pm.expect(pm.response.text()).to.not.include(\"passwordHash\"); });"]}}]},{"name":"02 Register invalid body (400)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/auth/register","body":{"mode":"raw","raw":"{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"400 with field messages\", () => pm.response.to.have.status(400));"]}}]},{"name":"03 Register duplicate email (409)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/auth/register","body":{"mode":"raw","raw":"{\n  \"name\": \"Lina Again\",\n  \"email\": \"lead@inspectflow.demo\",\n  \"password\": \"Password123\"\n}","options":{"raw":{"language":"json"}}}},"event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));"]}}]},{"name":"04 Login Lead (200)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base}}/auth/login","body":{"mode":"raw","raw":"{\n  \"email\": \"lead@inspectflow.demo\",\n  \"password\": \"Demo@12345\"\n}","opt